@model IEnumerable<Tournament>



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PitchPerfect | Active Tournaments</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .bg-slate-950 {
            background-color: #020617;
        }
    </style>
</head>
<body class="bg-slate-950 text-white font-sans min-h-screen">


    <div class="max-w-7xl mx-auto px-4 py-16">

        @* Header Section *@
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
            <div>
                <h1 class="text-4xl md:text-6xl font-black tracking-tighter uppercase">
                    Active <span class="text-green-500">Tournaments</span>
                </h1>
                <p class="text-slate-400 mt-2">Browse competitions and track live results across the globe.</p>
            </div>
        @*     <a asp-area="Admin" asp-controller="Tournaments" asp-action="Create"
               class="bg-green-500 hover:bg-green-400 text-slate-950 px-8 py-3 rounded-xl font-bold transition-all transform hover:scale-105">
                + Host Tournament
            </a> *@
        </div>

        @* Tournament Cards Loop *@
        <div class="grid grid-cols-1 lg:grid-cols-1 gap-12">
            @foreach (var item in Model)
            {
                <div class="glass rounded-3xl p-6 md:p-10 shadow-2xl flex flex-col lg:flex-row gap-8 transition-all hover:border-green-500/30">

                    @* LEFT SIDE: Live Scores / Fixtures *@
                    <div class="w-full lg:w-1/3 space-y-4">
                        <h3 class="font-bold text-green-400 flex items-center gap-2 uppercase tracking-widest text-xs">
                            <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> @item.Status Matches
                        </h3>

                        @* Live Score Card 1 *@
                        <div class="bg-slate-900/80 p-5 rounded-2xl border border-slate-800">
                            <div class="flex justify-between items-center text-xs mb-3 text-slate-500">
                                <span>@item.Format</span>
                                <span class="bg-slate-800 px-2 py-0.5 rounded text-green-400">LIVE</span>
                            </div>
                            <div class="flex justify-between font-bold text-lg"><span>FC UNITED</span> <span>2</span></div>
                            <div class="flex justify-between font-bold text-lg mb-4"><span>WILDCATS FC</span> <span>1</span></div>

                            @* DYNAMIC GOAL SCORERS SECTION *@
                            <div class="border-t border-slate-800 pt-3 flex justify-between gap-2">
                                <div class="w-1/2">
                                    <p class="text-[10px] uppercase text-slate-500 font-bold mb-1">Scorers</p>
                                    <div class="text-[11px] text-slate-300">
                                        <i class="fa-solid fa-futbol text-green-500 mr-1"></i> J. Doe 24'
                                    </div>
                                </div>
                                <div class="w-1/2 text-right">
                                    <p class="text-[10px] uppercase text-slate-500 font-bold mb-1">Scorers</p>
                                    <div class="text-[11px] text-slate-300">
                                        <i class="fa-solid fa-futbol text-slate-600 mr-1"></i> S. Smith 55'
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* RIGHT SIDE: Brackets & Metadata *@
                    <div class="w-full lg:w-2/3 bg-slate-900/40 rounded-2xl p-8 border border-slate-800 relative overflow-hidden">
                        <div class="flex justify-between items-start mb-8">
                            <div>
                                <h2 class="text-3xl font-black text-white">@item.Name</h2>
                                <p class="text-slate-500 flex items-center gap-2 mt-1">
                                    <i class="fas fa-map-marker-alt text-green-500"></i> @item.Location
                                    <span class="mx-2">|</span>
                                    <i class="fas fa-calendar"></i> @item.StartDate?.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="text-slate-600 text-xs font-bold uppercase tracking-widest">Season</span>
                                <p class="font-black text-green-500 text-xl">@item.Season</p>
                            </div>
                        </div>

                        @* Bracket Visualization *@
                        <div class="flex items-center gap-6 mb-10 overflow-x-auto pb-4">
                            <div class="space-y-4 min-w-[150px]">
                                <div class="bg-green-500/10 border border-green-500/30 p-3 rounded-lg text-xs font-bold flex justify-between">
                                    <span>FC United</span> <span class="text-green-500">2</span>
                                </div>
                                <div class="bg-slate-800/50 border border-slate-700 p-3 rounded-lg text-xs font-bold text-slate-400">
                                    Strikers
                                </div>
                            </div>
                            <div class="w-12 h-px bg-slate-800 relative">
                                <div class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-green-500"></div>
                            </div>
                            <div class="bg-slate-800 border-2 border-slate-700 p-4 rounded-xl min-w-[180px] text-center">
                                <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Finalist 1</p>
                                <p class="font-bold text-green-500">FC UNITED</p>
                            </div>
                        </div>

                        @* Action Buttons *@
                        <div class="flex flex-wrap gap-4">
                            <a asp-area="Admin" asp-controller="Tournaments" asp-action="Brackets" asp-route-id="@item.TournamentId"
                               class="bg-slate-800 hover:bg-slate-700 text-white px-6 py-3 rounded-xl text-sm font-bold transition-all">
                                View Full Brackets
                            </a>
                         @*    <a asp-area="Admin" asp-controller="Tournaments" asp-action="LiveScores" asp-route-id="@item.TournamentId"
                               class="bg-slate-800 hover:bg-slate-700 text-white px-6 py-3 rounded-xl text-sm font-bold transition-all">
                                Live Center
                            </a> *@
                            <a asp-area="Customer" asp-controller="Home" asp-action="ViewDetails" asp-route-id="@item.TournamentId"
                               class="bg-slate-800 hover:bg-slate-700 text-white px-6 py-3 rounded-xl text-sm font-bold transition-all">
                                Tournament Details
                            </a>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

</body>
</html>