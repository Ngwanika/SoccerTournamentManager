@model IEnumerable<Tournament>

@{
    ViewData["Title"] = "Tournaments";
    ViewData["FullWidth"] = true;
    var tournaments = Model.ToList();
    var statuses = tournaments
        .Select(tournament => tournament.Status)
        .Where(status => !string.IsNullOrWhiteSpace(status))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(status => status)
        .ToList();
}

@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
}

<section class="max-w-7xl mx-auto px-4 py-12 md:py-16 text-white">
    <header class="mb-8 md:mb-10">
        <h1 class="text-4xl md:text-6xl font-black tracking-tighter uppercase">
            Tournament <span class="text-green-500">directory</span>
        </h1>
        <p class="text-slate-400 mt-3 max-w-2xl">
            Search competitions by name or location, or filter by their current status.
        </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_16rem] gap-4 mb-8">
        <div>
            <label for="tournament-search" class="block text-sm font-bold text-slate-300 mb-2">Search tournaments</label>
            <input id="tournament-search" type="search" autocomplete="off"
                   placeholder="Search by name or location"
                   class="w-full rounded-xl bg-slate-800 border border-slate-700 px-4 py-3 text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>
        <div>
            <label for="tournament-status" class="block text-sm font-bold text-slate-300 mb-2">Status</label>
            <select id="tournament-status"
                    class="w-full rounded-xl bg-slate-800 border border-slate-700 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-green-500">
                <option value="">All statuses</option>
                @foreach (var status in statuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
    </div>

    <p id="tournament-count" class="text-sm text-slate-400 mb-4" aria-live="polite">
        @tournaments.Count tournament@(tournaments.Count == 1 ? "" : "s")
    </p>

    @if (tournaments.Count == 0)
    {
        <div class="glass rounded-2xl p-8 text-center text-slate-300" role="status">
            No tournaments are available yet.
        </div>
    }
    else
    {
        <div id="tournament-list" class="space-y-5">
            @foreach (var tournament in tournaments)
            {
                <article class="tournament-card glass rounded-3xl p-6 md:p-8 border border-slate-700"
                         data-name="@tournament.Name"
                         data-location="@tournament.Location"
                         data-status="@tournament.Status">
                    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-3 mb-3">
                                <h2 class="text-2xl md:text-3xl font-black">@tournament.Name</h2>
                                <span class="rounded-full bg-slate-800 px-3 py-1 text-sm text-green-400">@tournament.Status</span>
                            </div>
                            <dl class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-300">
                                @if (!string.IsNullOrWhiteSpace(tournament.Location))
                                {
                                    <div class="flex items-center gap-2">
                                        <dt class="sr-only">Location</dt>
                                        <i class="fas fa-map-marker-alt text-green-500" aria-hidden="true"></i>
                                        <dd>@tournament.Location</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(tournament.Format))
                                {
                                    <div class="flex items-center gap-2">
                                        <dt class="sr-only">Format</dt>
                                        <i class="fas fa-trophy text-green-500" aria-hidden="true"></i>
                                        <dd>@tournament.Format</dd>
                                    </div>
                                }
                                @if (tournament.StartDate.HasValue)
                                {
                                    <div class="flex items-center gap-2">
                                        <dt class="sr-only">Start date</dt>
                                        <i class="fas fa-calendar text-green-500" aria-hidden="true"></i>
                                        <dd>@tournament.StartDate.Value.ToString("MMM dd, yyyy")</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                        <div class="flex flex-wrap gap-3 shrink-0">
                            <a asp-area="Customer" asp-controller="Home" asp-action="ViewDetails" asp-route-id="@tournament.TournamentId"
                               class="bg-slate-800 hover:bg-slate-700 text-white px-5 py-3 rounded-xl text-sm font-bold transition-colors">
                                Tournament details
                            </a>
                            <a asp-area="Customer" asp-controller="Home" asp-action="ViewMatches" asp-route-id="@tournament.TournamentId"
                               class="bg-green-500 hover:bg-green-400 text-slate-950 px-5 py-3 rounded-xl text-sm font-bold transition-colors">
                                Fixtures and results
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
        <div id="tournament-empty-filter" class="glass rounded-2xl p-8 text-center text-slate-300 hidden" role="status">
            No tournaments match those filters. Try a different search or status.
        </div>
    }
</section>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("tournament-search");
            const statusFilter = document.getElementById("tournament-status");
            const cards = Array.from(document.querySelectorAll(".tournament-card"));
            const emptyMessage = document.getElementById("tournament-empty-filter");
            const count = document.getElementById("tournament-count");

            if (!searchInput || !statusFilter || !count) {
                return;
            }

            const filterTournaments = () => {
                const query = searchInput.value.trim().toLocaleLowerCase();
                const selectedStatus = statusFilter.value.toLocaleLowerCase();
                let visibleCount = 0;

                for (const card of cards) {
                    const matchesText = `${card.dataset.name} ${card.dataset.location}`
                        .toLocaleLowerCase()
                        .includes(query);
                    const matchesStatus = !selectedStatus
                        || card.dataset.status?.toLocaleLowerCase() === selectedStatus;
                    const visible = matchesText && matchesStatus;

                    card.classList.toggle("hidden", !visible);
                    if (visible) {
                        visibleCount++;
                    }
                }

                count.textContent = `${visibleCount} tournament${visibleCount === 1 ? "" : "s"}`;
                emptyMessage?.classList.toggle("hidden", visibleCount > 0);
            };

            searchInput.addEventListener("input", filterTournaments);
            statusFilter.addEventListener("change", filterTournaments);
        })();
    </script>
}
