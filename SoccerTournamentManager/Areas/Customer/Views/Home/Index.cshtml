<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PitchPerfect | Master the Beautiful Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .hero-gradient {
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 1)), url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
        }
    </style>
</head>
<body class="bg-slate-900 text-white font-sans">



    <section class="hero-gradient min-h-[80vh] flex flex-col items-center justify-center text-center px-4">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 max-w-4xl leading-tight">
            MASTER THE BEAUTIFUL <br><span class="text-green-500 text-shadow-lg">GAME’S CHAOS</span>
        </h1>
        <p class="text-slate-300 text-lg md:text-xl mb-10 max-w-2xl">
            The all-in-one management suite for soccer leagues. Automated brackets, real-time scores, and pro-level analytics.
        </p>
        <button class="bg-green-500 hover:bg-green-400 text-slate-950 px-10 py-4 rounded-xl font-black text-lg uppercase tracking-wider transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(34,197,94,0.4)]">
            Start Your League
        </button>
    </section>

    <section class="relative -mt-32 px-4 pb-20">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center text-2xl font-bold mb-12 uppercase tracking-widest text-slate-400">Command Your Competition</h2>

            <div class="glass rounded-3xl p-4 md:p-8 shadow-2xl flex flex-col md:flex-row gap-6">

                <div class="w-full md:w-1/3 space-y-4">
                    <h3 class="font-bold text-green-400 flex items-center gap-2">
                        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> Live Scores
                    </h3>
                    <div class="bg-slate-800/50 p-4 rounded-xl border border-slate-700">
                        <div class="flex justify-between items-center text-sm mb-2"><span>Quarterfinals</span> <span class="text-slate-500">75'</span></div>
                        <div class="flex justify-between font-bold"><span>FC UNITED</span> <span>2</span></div>
                        <div class="flex justify-between font-bold"><span>WILDCATS FC</span> <span>1</span></div>
                    </div>
                    <div class="bg-slate-800/50 p-4 rounded-xl border border-slate-700 opacity-60">
                        <div class="flex justify-between items-center text-sm mb-2"><span>Group A</span> <span class="text-slate-500">FT</span></div>
                        <div class="flex justify-between font-bold"><span>DRAGONS</span> <span>0</span></div>
                        <div class="flex justify-between font-bold"><span>STRIKERS</span> <span>4</span></div>
                    </div>
                </div>

                <div class="w-full md:w-2/3 bg-slate-800/40 rounded-2xl p-6 border border-slate-700">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="font-bold">Tournament Bracket</h3>
                        <div class="flex gap-2">
                            <span class="w-3 h-3 rounded-full bg-slate-600"></span>
                            <span class="w-3 h-3 rounded-full bg-slate-600"></span>
                        </div>
                    </div>
                    <div class="space-y-8">
                        <div class="flex items-center gap-4">
                            <div class="w-32 h-10 bg-green-500/20 border border-green-500/50 rounded flex items-center px-3 text-xs">FC United</div>
                            <div class="h-px w-8 bg-slate-600"></div>
                            <div class="w-32 h-10 bg-slate-700 rounded flex items-center px-3 text-xs">TBD</div>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="w-32 h-10 bg-slate-700 rounded flex items-center px-3 text-xs">Strikers</div>
                            <div class="h-px w-8 bg-slate-600"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-8 py-20 grid grid-cols-1 md:grid-cols-4 gap-12 text-center">
        <div>
            <div class="text-green-400 text-3xl mb-4"><i class="fas fa-calendar-alt"></i></div>
            <h4 class="font-bold mb-2">Automated Scheduling</h4>
            <p class="text-slate-400 text-sm">Conflict-free match timings in seconds.</p>
        </div>
        <div>
            <div class="text-green-400 text-3xl mb-4"><i class="fas fa-id-card"></i></div>
            <h4 class="font-bold mb-2">Digital Player Cards</h4>
            <p class="text-slate-400 text-sm">Verify eligibility with mobile-first IDs.</p>
        </div>
        <div>
            <div class="text-green-400 text-3xl mb-4"><i class="fas fa-trophy"></i></div>
            <h4 class="font-bold mb-2">Live Standings</h4>
            <p class="text-slate-400 text-sm">Instant updates across all devices.</p>
        </div>
        <div>
            <div class="text-green-400 text-3xl mb-4"><i class="fas fa-video"></i></div>
            <h4 class="font-bold mb-2">Real-Time Updates</h4>
            <p class="text-slate-400 text-sm">Push notifications for goals and results.</p>
        </div>
    </section>

</body>
</html>