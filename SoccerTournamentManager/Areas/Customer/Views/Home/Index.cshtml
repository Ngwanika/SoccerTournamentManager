@{
    ViewData["Title"] = "PitchPerfect";
    ViewData["FullWidth"] = true;
}

@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .hero-gradient {
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 1)), url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
        }
    </style>
}

<section class="hero-gradient min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-20">
    <h1 class="text-5xl md:text-7xl font-extrabold mb-6 max-w-4xl leading-tight">
        MASTER THE BEAUTIFUL <br><span class="text-green-500 text-shadow-lg">GAME’S CHAOS</span>
    </h1>
    <p class="text-slate-300 text-lg md:text-xl mb-8 max-w-2xl">
        Explore soccer tournaments, follow match schedules and results, and keep your competition organized.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
        <a asp-area="Customer" asp-controller="Home" asp-action="ViewTornaments"
           class="bg-green-500 hover:bg-green-400 text-slate-950 px-10 py-4 rounded-xl font-black text-lg uppercase tracking-wider transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(34,197,94,0.4)]">
            Browse tournaments
        </a>
        <a asp-area="Identity" asp-page="/Account/Register"
           class="text-white underline underline-offset-4 hover:text-green-400 px-4 py-3 font-bold">
            Create an account
        </a>
    </div>
</section>

<section class="relative -mt-16 px-4 pb-16">
    <div class="max-w-6xl mx-auto">
        <div class="glass rounded-3xl p-6 md:p-10 shadow-2xl grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-4">
                <h2 class="font-bold text-green-400 text-xl">Follow the competition</h2>
                <p class="text-slate-300">
                    Find a tournament to see its details, participants, fixtures, and results in one place.
                </p>
                <a asp-area="Customer" asp-controller="Home" asp-action="ViewTornaments"
                   class="inline-flex items-center gap-2 text-green-400 font-bold hover:text-green-300">
                    Explore tournaments <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="bg-slate-800/40 rounded-2xl p-6 border border-slate-700">
                <h2 class="font-bold mb-5">PitchPerfect helps you keep track of:</h2>
                <ul class="space-y-4 text-slate-300">
                    <li class="flex items-center gap-3">
                        <i class="bi bi-calendar-event text-green-400" aria-hidden="true"></i>
                        Tournament dates and match schedules
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="bi bi-trophy text-green-400" aria-hidden="true"></i>
                        Competition details and participants
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="bi bi-activity text-green-400" aria-hidden="true"></i>
                        Match scores and results
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="max-w-7xl mx-auto px-6 md:px-8 py-12 md:py-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 text-center">
    <div>
        <div class="text-green-400 text-3xl mb-4"><i class="fas fa-calendar-alt" aria-hidden="true"></i></div>
        <h2 class="font-bold mb-2">Tournament schedules</h2>
        <p class="text-slate-400 text-sm">Find upcoming fixtures and match times.</p>
    </div>
    <div>
        <div class="text-green-400 text-3xl mb-4"><i class="fas fa-users" aria-hidden="true"></i></div>
        <h2 class="font-bold mb-2">Team management</h2>
        <p class="text-slate-400 text-sm">Keep team details and player rosters together.</p>
    </div>
    <div>
        <div class="text-green-400 text-3xl mb-4"><i class="fas fa-trophy" aria-hidden="true"></i></div>
        <h2 class="font-bold mb-2">Tournament details</h2>
        <p class="text-slate-400 text-sm">Review competition formats, dates, and locations.</p>
    </div>
    <div>
        <div class="text-green-400 text-3xl mb-4"><i class="fas fa-futbol" aria-hidden="true"></i></div>
        <h2 class="font-bold mb-2">Match results</h2>
        <p class="text-slate-400 text-sm">Follow scores and completed match results.</p>
    </div>
</section>
