@model IReadOnlyList<Match>

@{
    ViewData["Title"] = "Match official workspace";
}

<main class="container py-4">
    <h1 class="h3 mb-1">Match official workspace</h1>
    <p class="text-secondary">Open an assigned match to start play, record events, and finish the match.</p>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">No matches are currently assigned to you.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Match</th><th>Tournament</th><th>Date</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var match in Model)
                    {
                        <tr>
                            <td>@match.HomeTeam?.TeamName vs @match.AwayTeam?.TeamName</td>
                            <td>@match.Tournament?.Name</td>
                            <td>@match.MatchDate.ToLocalTime().ToString("g")</td>
                            <td>@match.Status</td>
                            <td><a asp-action="Manage" asp-route-id="@match.MatchId" class="btn btn-sm btn-primary">Open match</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
