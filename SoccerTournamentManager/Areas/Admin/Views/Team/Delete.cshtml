@model Team

<body class="bg-pp-navy">

    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-blue bg-primary ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Delete Team</h2>
            </div>
        </div>
    </div>
        <div class="card-body p-4">
        <form method="post">
            <input asp-for="TeamId" hidden />
              <div class="border p-3 mt-4">
                 <div class="row pb-2 text-center">
                        <h2 class="text-primary">Delete Team : @Model.TeamName </h2>
                        <hr />
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="TeamName" class="ms-2"></label>
                    <input asp-for="TeamName" class="form-control border-0 shadow" />
                    <span asp-validation-for="TeamName" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="CoachName" class="ms-2"></label>
                    <input asp-for="CoachName" class="form-control border-0 shadow" />
                    <span asp-validation-for="CoachName" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="Homestadium" class="ms-2"></label>
                    <input asp-for="Homestadium" class="form-control border-0 shadow" />
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="Email" class="ms-2"></label>
                    <input asp-for="Email" class="form-control border-0 shadow" />
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="ContactNumber1" class="ms-2"></label>
                    <input asp-for="ContactNumber1" class="form-control border-0 shadow" />
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="ContactNumber2" class="ms-2"></label>
                    <input asp-for="ContactNumber2" class="form-control border-0 shadow" />
                </div>
                <div class="form-floating py-2 col-12">
                    <label asp-for="Established" class="ms-2"></label>
                    <input asp-for="Established" type="date" class="form-control border-0 shadow" />
                </div>

                <div class="row">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-danger form-control">Delete</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Team" asp-action="Index" class="btn btn-secondary border  form-control">
                            Back to List
                        </a>
                    </div>
                </div>


            </div>
        </form>
        </div>
    </div>


</body>



