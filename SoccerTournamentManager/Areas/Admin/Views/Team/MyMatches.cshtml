@* Areas/Admin/Views/Team/MyMatches.cshtml *@
@model TeamMatchesVM

@{
    ViewData["Title"] = "My Matches";
    var teamId = Model.TeamId;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Matches — @Model.TeamName</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --bg: #07090f;
            --surface: #0e1118;
            --card: #13171f;
            --border: #1e2330;
            --border-hi: #2a3040;
            --text: #e8eaf0;
            --muted: #5a6278;
            --subtle: #9aa0b4;
            --blue: #3b82f6;
            --blue-dim: rgba(59,130,246,.15);
            --green: #22c55e;
            --green-dim: rgba(34,197,94,.12);
            --red: #ef4444;
            --red-dim: rgba(239,68,68,.12);
            --amber: #f59e0b;
            --amber-dim: rgba(245,158,11,.12);
            --live: #ff3b3b;
            --r: 10px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            line-height: 1.5;
        }

        /* HERO */
        .hero {
            background: linear-gradient(160deg, #0d1525 0%, #07090f 55%);
            border-bottom: 1px solid var(--border);
            padding: 44px 48px 36px;
            position: relative;
            overflow: hidden;
        }

            .hero::after {
                content: '';
                position: absolute;
                right: -80px;
                top: -80px;
                width: 380px;
                height: 380px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(59,130,246,.08) 0%, transparent 70%);
                pointer-events: none;
            }

        .hero-eyebrow {
            font-family: 'Syne', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3.5px;
            text-transform: uppercase;
            color: var(--blue);
            margin-bottom: 10px;
        }

        .hero-title {
            font-family: 'Syne', sans-serif;
            font-size: clamp(28px, 4.5vw, 46px);
            font-weight: 800;
            line-height: 1.05;
            letter-spacing: -1.5px;
        }

            .hero-title .team-name {
                color: var(--blue);
            }

        .hero-sub {
            margin-top: 10px;
            font-size: 14px;
            color: var(--muted);
        }

        /* LAYOUT */
        .page-wrap {
            display: grid;
            grid-template-columns: 260px 1fr;
            min-height: calc(100vh - 130px);
        }

        /* SIDEBAR */
        .sidebar {
            border-right: 1px solid var(--border);
            padding: 28px 0;
            background: var(--surface);
            display: flex;
            flex-direction: column;
        }

        .sidebar-heading {
            font-family: 'Syne', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: var(--muted);
            padding: 0 20px 14px;
        }

        .t-link {
            display: flex;
            flex-direction: column;
            gap: 3px;
            padding: 14px 20px;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: background .15s, border-color .15s;
        }

            .t-link:hover {
                background: rgba(59,130,246,.06);
            }

            .t-link.active {
                border-left-color: var(--blue);
                background: rgba(59,130,246,.08);
            }

        .t-link-name {
            font-family: 'Syne', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

        .t-link.active .t-link-name {
            color: var(--blue);
        }

        .t-link-meta {
            font-size: 11px;
            color: var(--muted);
        }

        .t-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 5px;
            vertical-align: middle;
        }

        .dot-active {
            background: var(--green);
        }

        .dot-upcoming {
            background: var(--amber);
        }

        .dot-completed {
            background: var(--muted);
        }

        .no-tournaments {
            padding: 24px 20px;
            font-size: 13px;
            color: var(--muted);
            line-height: 1.6;
        }

        .sidebar-footer {
            padding: 24px 20px 0;
            border-top: 1px solid var(--border);
            margin-top: auto;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--muted);
            font-size: 13px;
            text-decoration: none;
            transition: color .15s;
        }

            .back-link:hover {
                color: var(--text);
            }

        /* MAIN */
        .main {
            padding: 32px 36px;
            overflow-x: hidden;
        }

        /* PICK PROMPT */
        .pick-prompt {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 400px;
            gap: 16px;
            color: var(--muted);
            text-align: center;
        }

            .pick-prompt i {
                font-size: 64px;
                opacity: .2;
            }

            .pick-prompt h3 {
                font-family: 'Syne', sans-serif;
                font-size: 20px;
                color: var(--subtle);
            }

        /* SECTION HEADER */
        .section-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .match-count {
            font-size: 13px;
            color: var(--muted);
        }

        /* STAGE LABEL */
        .stage-label {
            font-family: 'Syne', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: var(--muted);
            margin: 28px 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .stage-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        /* MATCH CARD */
        .match-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r);
            margin-bottom: 14px;
            overflow: hidden;
            transition: border-color .2s, transform .15s;
        }

            .match-card:hover {
                border-color: var(--border-hi);
                transform: translateY(-2px);
            }

            .match-card.result-win {
                border-left: 4px solid var(--green);
            }

            .match-card.result-loss {
                border-left: 4px solid var(--red);
            }

            .match-card.result-draw {
                border-left: 4px solid var(--amber);
            }

            .match-card.result-live {
                border-left: 4px solid var(--live);
            }

        /* MATCH ROW */
        .match-main {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            padding: 20px 24px;
            gap: 12px;
        }

        .team-col {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .team-col.away {
                flex-direction: row-reverse;
                text-align: right;
            }

        .team-logo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border);
            flex-shrink: 0;
        }

        .team-logo-ph {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-size: 14px;
            font-weight: 800;
            color: var(--muted);
            flex-shrink: 0;
        }

        .team-name-label {
            font-family: 'Syne', sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.2;
        }

            .team-name-label.mine {
                color: var(--blue);
            }

        .team-side {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }

        /* SCORE */
        .score-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            min-width: 100px;
        }

        .score-box {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .score-num {
            font-family: 'Syne', sans-serif;
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
            min-width: 28px;
            text-align: center;
        }

        .score-sep {
            font-size: 24px;
            color: var(--border-hi);
        }

        .score-tbd {
            font-family: 'Syne', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--muted);
            letter-spacing: 2px;
        }

        /* BADGE */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .badge-win {
            background: var(--green-dim);
            color: var(--green);
        }

        .badge-loss {
            background: var(--red-dim);
            color: var(--red);
        }

        .badge-draw {
            background: var(--amber-dim);
            color: var(--amber);
        }

        .badge-live {
            background: rgba(255,59,59,.15);
            color: var(--live);
        }

        .badge-upcoming {
            background: var(--blue-dim);
            color: var(--blue);
        }

        .live-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--live);
        }

        .match-date {
            font-size: 11px;
            color: var(--muted);
        }

        /* GOALS */
        .match-details {
            border-top: 1px solid var(--border);
            padding: 14px 24px;
            background: rgba(255,255,255,.015);
        }

        .goals-label {
            font-family: 'Syne', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 10px;
        }

        .goals-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 20px;
        }

        .goal-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--subtle);
        }

        .goal-icon {
            color: var(--green);
            font-size: 11px;
        }

        .penalty-icon {
            color: var(--amber);
            font-size: 11px;
        }

        .goal-min {
            font-family: 'Syne', sans-serif;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
        }

        .team-tag {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            background: var(--border);
            color: var(--muted);
        }

        .pen-tag {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            background: var(--amber-dim);
            color: var(--amber);
        }

        .no-goals {
            font-size: 12px;
            color: var(--muted);
            font-style: italic;
        }

        /* EMPTY */
        .empty-matches {
            text-align: center;
            padding: 80px 24px;
            color: var(--muted);
        }

            .empty-matches i {
                font-size: 52px;
                display: block;
                margin-bottom: 16px;
                opacity: .2;
            }

            .empty-matches h3 {
                font-size: 18px;
                color: var(--subtle);
                margin-bottom: 6px;
            }
    </style>
</head>
<body>

    <div class="hero">
        <div class="hero-eyebrow">Team Portal</div>
        <h1 class="hero-title"><span class="team-name">@Model.TeamName</span><br />My Matches</h1>
        <p class="hero-sub">Select a tournament from the sidebar to view your fixtures and results.</p>
    </div>

    <div class="page-wrap">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-heading">My Tournaments</div>

            @if (!Model.ApprovedTournaments.Any())
            {
                <div class="no-tournaments">
                    <i class="bi bi-trophy" style="display:block;font-size:28px;margin-bottom:10px;opacity:.3;"></i>
                    You are not approved in any tournament yet.
                </div>
            }

            @foreach (var t in Model.ApprovedTournaments)
            {
                <a asp-action="MyMatches" asp-controller="Team"
                   asp-route-teamId="@teamId"
                   asp-route-tournamentId="@t.TournamentId"
                   class="t-link @(t.TournamentId == Model.SelectedTournamentId ? "active" : "")">
                    <span class="t-link-name">@t.Name</span>
                    <span class="t-link-meta">
                        <span class="t-dot @t.DotClass"></span>@t.Status
                        @if (t.StartDate.HasValue)
                        {
                            <text> · @t.StartDate.Value.ToString("MMM yyyy")</text>
                        }
                    </span>
                </a>
            }

            <div class="sidebar-footer">
                <a asp-action="TeamDetails" asp-route-id="@teamId" class="back-link">
                    <i class="bi bi-arrow-left"></i> Team Details
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            @if (Model.SelectedTournamentId == null)
            {
                <div class="pick-prompt">
                    <i class="bi bi-layout-sidebar-reverse"></i>
                    <h3>Choose a tournament</h3>
                    <p>Pick one from the sidebar to see your fixtures &amp; results.</p>
                </div>
            }
            else if (!Model.GroupedMatches.Any())
            {
                <div class="section-header">
                    <div class="section-title">@Model.SelectedTournamentName</div>
                </div>
                <div class="empty-matches">
                    <i class="bi bi-calendar-x"></i>
                    <h3>No matches scheduled yet</h3>
                    <p>Check back once the tournament admin has set up the fixtures.</p>
                </div>
            }
            else
            {
                <div class="section-header">
                    <div class="section-title">@Model.SelectedTournamentName</div>
                    <span class="match-count">@Model.TotalMatchCount match@(Model.TotalMatchCount == 1 ? "" : "es")</span>
                </div>

                @foreach (var stageGroup in Model.GroupedMatches)
                {
                    <div class="stage-label">@stageGroup.Stage</div>

                    @foreach (var match in stageGroup.Matches)
                    {
                        <div class="match-card @match.ResultCardClass">

                            <div class="match-main">

                                <!-- Home team -->
                                <div class="team-col home">
                                    @if (!string.IsNullOrEmpty(match.HomeTeamLogo))
                                    {
                                        <img src="@match.HomeTeamLogo" alt="@match.HomeTeamName" class="team-logo" />
                                    }
                                    else
                                    {
                                        <div class="team-logo-ph">@match.HomePlaceholder</div>
                                    }
                                    <div>
                                        <div class="team-name-label @(match.HomeTeamId == teamId ? "mine" : "")">@match.HomeTeamName</div>
                                        <div class="team-side">Home</div>
                                    </div>
                                </div>

                                <!-- Score / status -->
                                <div class="score-center">
                                    @if (match.ScoreAvailable)
                                    {
                                        <div class="score-box">
                                            <span class="score-num">@match.HomeScore</span>
                                            <span class="score-sep">–</span>
                                            <span class="score-num">@match.AwayScore</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="score-tbd">@match.MatchDate.ToString("HH:mm")</div>
                                    }

                                    <div class="status-badge @match.ResultBadgeClass">
                                        @if (match.Result == "Live")
                                        {
                                            <span class="live-dot"></span>
                                        }
                                        @match.Result
                                    </div>

                                    <div class="match-date">@match.MatchDate.ToString("dd MMM yyyy")</div>
                                </div>

                                <!-- Away team -->
                                <div class="team-col away">
                                    @if (!string.IsNullOrEmpty(match.AwayTeamLogo))
                                    {
                                        <img src="@match.AwayTeamLogo" alt="@match.AwayTeamName" class="team-logo" />
                                    }
                                    else
                                    {
                                        <div class="team-logo-ph">@match.AwayPlaceholder</div>
                                    }
                                    <div>
                                        <div class="team-name-label @(match.AwayTeamId == teamId ? "mine" : "")">@match.AwayTeamName</div>
                                        <div class="team-side">Away</div>
                                    </div>
                                </div>

                            </div>

                            <!-- Goals panel -->
                            @if (match.Status == "Completed" || match.Goals.Any())
                            {
                                <div class="match-details">
                                    <div class="goals-label"><i class="bi bi-bullseye"></i> Goal Scorers</div>

                                    @if (!match.Goals.Any())
                                    {
                                        <span class="no-goals">No goal details recorded.</span>
                                    }
                                    else
                                    {
                                        <div class="goals-list">
                                            @foreach (var goal in match.Goals)
                                            {
                                                <div class="goal-item">
                                                    @if (goal.IsPenalty)
                                                    {
                                                        <i class="bi bi-p-circle-fill penalty-icon"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle-fill goal-icon"></i>
                                                    }
                                                    <span>@goal.ScorerName</span>
                                                    <span class="goal-min">@(goal.Minute)'</span>
                                                    <span class="team-tag">
                                                        @(goal.TeamId == match.HomeTeamId ? match.HomeTeamName : match.AwayTeamName)
                                                    </span>
                                                    @if (goal.IsPenalty)
                                                    {
                                                        <span class="pen-tag">pen</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    }
                }
            }

        </main>
    </div>

</body>
</html>
