@model IReadOnlyList<TeamContactMessage>

@{
    ViewData["Title"] = "Team messages";
}

<main class="container py-4">
    <h1 class="h3">Team messages</h1>
    <p class="text-secondary">Authenticated messages from team managers. Reply to the sender at the listed email address.</p>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">No team messages have been received.</div>
    }
    else
    {
        @foreach (var message in Model)
        {
            <article class="border border-secondary rounded p-3 mb-3">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <h2 class="h5 mb-1">@message.Subject</h2>
                        <p class="text-secondary mb-2">
                            @message.Team.TeamName · <a href="mailto:@message.ReplyEmail">@message.ReplyEmail</a>
                            · @message.SentAtUtc.ToLocalTime().ToString("g")
                        </p>
                    </div>
                    <span class="badge @(message.IsRead ? "bg-secondary" : "bg-primary") align-self-start">
                        @(message.IsRead ? "Read" : "New")
                    </span>
                </div>
                <p class="mb-3" style="white-space:pre-wrap">@message.Message</p>
                @if (!message.IsRead)
                {
                    <form asp-action="MarkRead" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@message.TeamContactMessageId" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Mark as read</button>
                    </form>
                }
            </article>
        }
    }
</main>
