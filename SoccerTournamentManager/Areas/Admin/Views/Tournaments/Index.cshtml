@model IEnumerable<SoccerTournament.Models.Tournament>




<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Tournaments</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-area="Admin" asp-controller="Tournaments" asp-action="Upsert" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Create New Tournament
            </a>
        </div>
    </div>

    <br /><br />

    @if (Model.Any())
    {
        <table class="table table-bordered table-striped mt-3" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Start Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td width="20%">@obj.Name</td>
                        <td width="20%">@obj.Location</td>
                        <td width="10%">
                            @* Visual Status Badges *@
                            @if (obj.Status?.ToLower() == "active")
                            {
                                <span class="badge bg-success">@obj.Status</span>
                            }
                            else if (obj.Status?.ToLower() == "upcoming")
                            {
                                <span class="badge bg-info text-dark">@obj.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@obj.Status</span>
                            }
                        </td>
                        <td width="15%">@obj.StartDate?.ToShortDateString()</td>
                        <td>
                            <div class="w-100 btn-group" role="group">

                                <a asp-action="Details" asp-route-id="@obj.TournamentId" class="btn btn-info mx-1">
                                    Details
                                </a>
                                <a asp-action="Upsert" asp-route-id="@obj.TournamentId" class="btn btn-warning mx-1">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@obj.TournamentId" class="btn btn-danger mx-1">
                                    Delete
                                </a>
                            </div>
                        </td>
                        @*    <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@obj.TournamentId" class="btn btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@obj.TournamentId" class="btn btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@obj.TournamentId" class="btn btn-danger">Delete</a>
                            </div>
                        </td> *@
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning mt-4" role="alert">
            No tournaments have been created yet. Click "Create New Tournament" to begin.
        </div>
    }
</div>