@model List<Player>

<input type="hidden" id="teamId" value="@ViewBag.TeamId" />
<div class="bg-pp-navy min-vh-100 p-4 rounded-3">
    <div class="card shadow border-0 mt-4 bg-white">
        <div class="card-header bg-primary  py-3 border-0">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h2 class="text-pp-green mb-0 px-2">Player Registry</h2>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <a asp-area="TeamManager" asp-controller="Player" asp-action="Upsert" asp-route-id="@ViewBag.TeamId" class="btn btn-pp-green shadow-sm">
                        <i class="bi bi-person-plus-fill"></i> Add New Player
                    </a>
                </div>
            </div>
        </div>


        <div class="card-body p-4">

            <table id="tblData" class="table table-bordered table-striped" style="width:100%">
                <thead>
                    <tr>
                        <th>firstName</th>
                        <th>lastName</th>
                        <th>jerseyNumber</th>
                        <th>dateOfBirth</th>
                        <th>teamId</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
            
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/players.js"></script>

    <script>
        var teamId = '@ViewBag.TeamId';
    </script>
}
